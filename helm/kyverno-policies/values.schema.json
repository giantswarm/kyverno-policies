{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bestPracticesPolicies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "policies": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "check-resources-request-and-limits-ratio": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "disallow-latest-tag": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "prevent-bare-pods": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "require-container-requests-and-limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "require-emptydir-requests-and-limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "require-pod-probes": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "debugAccessPolicies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowedDebugContainerImages": {
                    "type": "array"
                },
                "authorizedDebugTargets": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "allDeployments": {
                                "type": "boolean"
                            },
                            "allowedDebugContainerImages": {},
                            "deployments": {
                                "type": "array"
                            },
                            "namespaces": {
                                "type": "array"
                            }
                        }
                    }
                },
                "policies": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "block-expired-exceptions": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "disallow-ephemeral-containers": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "disallow-unapproved-debug-access": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "purge-expired-exceptions": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cleanupSchedule": {
                                    "type": "string"
                                },
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                },
                                "targetAnnotation": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as the `additionalProperties` setting would otherwise collide with Helm's special 'global' values key."
        },
        "kyverno-policies": {
            "type": "object",
            "additionalProperties": true
        },
        "policyNamePrefix": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "supplementalSecurityPolicies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "policies": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "add-default-deny-network-policy": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "deleteNetworkPolicyOnKyvernoPolicyDeletion": {
                                    "type": "boolean"
                                },
                                "enabled": {
                                    "type": "boolean"
                                },
                                "generateForExistingNamespaces": {
                                    "type": "boolean"
                                },
                                "networkPolicy": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "blockEgress": {
                                            "type": "boolean"
                                        },
                                        "blockIngress": {
                                            "type": "boolean"
                                        },
                                        "policyName": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "audit-event-on-exec": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "check-serviceaccount-secrets": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "disallow-gitrepo-volume": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "require-ro-rootfs": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "restrict-binding-clusteradmin": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "restrict-binding-system-groups": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "restrict-external-ips": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        },
                        "restrict-sa-automount-sa-token": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
